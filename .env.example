# ─────────────────────────────────────────────────────────────
# Jokko — variables d'environnement (copier vers .env, ne jamais committer .env)
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── API ──────────────────────────────────────────────────────
API_PORT=3333
API_HOST=0.0.0.0
API_GLOBAL_PREFIX=api
# Origines autorisées (CSV) pour CORS
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jokko
POSTGRES_USER=jokko
POSTGRES_PASSWORD=jokko_dev_pwd
DATABASE_URL=postgres://jokko:jokko_dev_pwd@localhost:5432/jokko

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Meilisearch ──────────────────────────────────────────────
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=jokko_dev_meili_master_key

# ── Stockage objet (MinIO / S3) ──────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=jokko
S3_SECRET_KEY=jokko_dev_secret
S3_BUCKET=jokko-media
S3_FORCE_PATH_STYLE=true

# ── imgproxy ─────────────────────────────────────────────────
IMGPROXY_URL=http://localhost:8080
IMGPROXY_KEY=
IMGPROXY_SALT=

# ── Observabilité ────────────────────────────────────────────
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Multi-tenant ─────────────────────────────────────────────
# Domaine racine des sous-domaines de boutiques (prod: jokko.shop)
SHOP_ROOT_DOMAIN=lvh.me
# Secret de signature de l'en-tête x-shop-id échangé entre le frontend edge et l'API
TENANT_HEADER_SECRET=change_me_dev_only
