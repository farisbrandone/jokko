# ─────────────────────────────────────────────────────────────
# Jokko — variables d'environnement (copier vers .env, ne jamais committer .env)
# Ports d'infra décalés (5xxxx) pour éviter les conflits avec d'autres projets.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── API ──────────────────────────────────────────────────────
API_PORT=3333
API_HOST=0.0.0.0
API_GLOBAL_PREFIX=api
# Origines autorisées (CSV) pour CORS
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=jokko
POSTGRES_USER=jokko
POSTGRES_PASSWORD=jokko_dev_pwd
# L'API utilise le rôle applicatif (non superuser) → la RLS s'applique.
DATABASE_URL=postgres://jokko_app:jokko_app_dev_pwd@localhost:55432/jokko
# Les migrations utilisent le rôle propriétaire (superuser).
DATABASE_ADMIN_URL=postgres://jokko:jokko_dev_pwd@localhost:55432/jokko

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:56379

# ── Meilisearch ──────────────────────────────────────────────
MEILI_URL=http://localhost:57700
MEILI_MASTER_KEY=jokko_dev_meili_master_key

# ── Stockage objet (MinIO / S3) ──────────────────────────────
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY=jokko
S3_SECRET_KEY=jokko_dev_secret
S3_BUCKET=jokko-media
S3_FORCE_PATH_STYLE=true

# ── imgproxy ─────────────────────────────────────────────────
IMGPROXY_URL=http://localhost:58080
IMGPROXY_KEY=
IMGPROXY_SALT=

# ── Notifications (e-mail) ───────────────────────────────────
# Dev : Mailpit (UI http://localhost:58025). `json` = transport sans réseau.
SMTP_URL=smtp://localhost:51025
SMTP_FROM=Jokko <no-reply@jokko.shop>
DASHBOARD_BASE_URL=http://localhost:3001

# ── Notifications WhatsApp / SMS + OTP (Termii) ──────────────
# Sans TERMII_API_KEY, ces canaux retombent sur un adaptateur « log ».
TERMII_API_KEY=
TERMII_SENDER_ID=Jokko
TERMII_BASE_URL=https://api.ng.termii.com
# Connexion par SMS (OTP)
OTP_TTL_SEC=300
OTP_MAX_PER_HOUR=5
# Code fixe pour dev / démo — LAISSER VIDE EN PRODUCTION
OTP_DEV_CODE=
# Délai anti-spam par défaut (s) entre 2 notifications d'une même conversation
NOTIFICATIONS_COOLDOWN_SEC=300
# Anti-spam acheteur : ouvertures de conversation max / numéro / heure
MESSAGING_MAX_NEW_CONVERSATIONS_PER_HOUR=6

# ── Notifications Web Push (VAPID) ──────────────────────────
# Générer : `npx web-push generate-vapid-keys`. Vide = canal push désactivé.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@jokko.shop

# ── Facturation (abonnement vendeur — Flutterwave) ─────────
# Sans FLW_SECRET_KEY : passerelle « fake » qui valide automatiquement (dev).
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=
FLW_BASE_URL=https://api.flutterwave.com
BILLING_PRICE_XOF=5000
BILLING_TRIAL_DAYS=14
BILLING_GRACE_DAYS=3
# URL publique utilisée comme redirect_url du paiement
APP_PUBLIC_URL=http://localhost:3001

# ── Limitation de débit ─────────────────────────────────────
THROTTLE_TTL_SEC=60
THROTTLE_LIMIT=600
# IP exemptées (front SSR interne, load balancer) — CSV
THROTTLE_TRUSTED_IPS=

# ── Observabilité ────────────────────────────────────────────
LOG_LEVEL=debug
# Traçage OTEL : renseigner l'endpoint d'un collector pour l'activer
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=jokko-api

# ── Multi-tenant ─────────────────────────────────────────────
# Domaine racine des sous-domaines de boutiques (prod: jokko.shop)
SHOP_ROOT_DOMAIN=lvh.me
# Secret HMAC de l'en-tête tenant signé (frontend edge → API)
TENANT_HEADER_SECRET=dev_tenant_header_secret_0123456789

# ── Auth ─────────────────────────────────────────────────────
AUTH_JWT_SECRET=dev_auth_jwt_secret_change_me_0123456789
AUTH_ACCESS_TTL_MIN=30
AUTH_REFRESH_TTL_DAYS=30
# AUTH_COOKIE_DOMAIN=.jokko.shop
