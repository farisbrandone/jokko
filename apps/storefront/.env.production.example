# apps/storefront/.env — copié tel quel dans la sortie standalone au build,
# donc à renseigner AVANT `pnpm --filter @jokko/storefront run build`
# (voir infra/scripts/build-standalone.sh et docs/deploiement-vps.md).
JOKKO_API_URL=https://api.scoliaa.com/api
NEXT_PUBLIC_SITE_URL=https://scoliaa.com
SHOP_ROOT_DOMAIN=scoliaa.com
DEFAULT_SHOP_SLUG=
# URL du tableau de bord vendeur — CTA « Créer ma boutique » de la page d'accueil.
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.scoliaa.com
# Hôte des images produits (= S3_ENDPOINT côté API, sans le chemin de bucket) :
# autorisé pour l'optimiseur d'images Next (/_next/image). Voir next.config.ts.
MEDIA_ORIGIN=https://media.scoliaa.com
