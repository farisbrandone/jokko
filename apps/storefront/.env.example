# URL de l'API Jokko vue par le serveur Next (SSR / route handlers)
JOKKO_API_URL=http://localhost:3333/api
# URL publique de la vitrine (métadonnées, canonical, OG)
NEXT_PUBLIC_SITE_URL=http://lvh.me:3000
# Domaine racine des sous-domaines de boutiques
SHOP_ROOT_DOMAIN=lvh.me
# Boutique par défaut en dev quand aucun sous-domaine n'est fourni (facultatif)
DEFAULT_SHOP_SLUG=
# URL du tableau de bord vendeur — CTA « Créer ma boutique » de la page d'accueil
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
