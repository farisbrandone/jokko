{
  "name": "@jokko/api",
  "version": "0.0.0",
  "private": true,
  "description": "Jokko API — NestJS (Fastify), architecture hexagonale par contexte.",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:int": "pnpm run build",
    "test:int": "vitest run --config vitest.int.config.ts",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:migrate:prod": "node dist/cli/migrate.js",
    "search:reindex": "tsx src/cli/reindex.ts",
    "search:reindex:prod": "node dist/cli/reindex.js",
    "make-admin": "tsx src/cli/make-admin.ts",
    "db:migrate:make": "mikro-orm migration:create",
    "db:fresh": "mikro-orm schema:drop --run --drop-migrations-table && tsx src/cli/migrate.ts"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/config/mikro-orm.config.ts",
      "./dist/config/mikro-orm.config.js"
    ],
    "useTsNode": true,
    "tsConfigPath": "./tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/s3-request-presigner": "^3.717.0",
    "@casl/ability": "^6.7.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.2",
    "@jokko/contracts": "workspace:*",
    "@jokko/domain-kernel": "workspace:*",
    "@mikro-orm/core": "^6.4.2",
    "@mikro-orm/migrations": "^6.4.2",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.4.2",
    "@nestjs/common": "^11.0.5",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.5",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/platform-fastify": "^11.0.5",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.0.3",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.2.1",
    "jose": "^5.9.6",
    "meilisearch": "^0.47.0",
    "nestjs-pino": "^4.3.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.4.2",
    "@nestjs/cli": "^11.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.5",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "pino-pretty": "^13.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^10.16.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
