# Caddy — déploiement natif VPS (pm2, sans Docker pour les apps Node).
# Adapté de infra/caddy/Caddyfile (variante Docker/Caddy) : mêmes hôtes,
# proxy vers 127.0.0.1:<port> au lieu des noms de conteneurs.
#
# À copier vers /etc/caddy/Caddyfile puis :
#   sed -i 's/VOTREDOMAINE\.TLD/votredomaine.tld/g' /etc/caddy/Caddyfile
#   systemctl reload caddy
#
# Deux familles d'hôtes, deux stratégies TLS différentes (voir
# docs/deploiement-vps.md, §5) :
#
#  1. VOTREDOMAINE.TLD, *.VOTREDOMAINE.TLD, api./dashboard./console./media./
#     img.VOTREDOMAINE.TLD : DNS **proxied** chez Cloudflare (nuage orange).
#     Le navigateur ne parle jamais TLS directement à ce VPS pour ces hôtes ;
#     Cloudflare gère le certificat public (wildcard inclus, gratuit). Il
#     suffit d'un certificat d'origine Cloudflare ici (gratuit, 15 ans,
#     Cloudflare → SSL/TLS → Origine → Créer un certificat, mode de
#     chiffrement de la zone réglé sur « Full (strict) »).
#
#  2. Domaines personnalisés des boutiques (bloc `:443` en bas) : DNS **non
#     proxied** (gris) chez le client, pointant en direct sur ce VPS — Caddy
#     émet et renouvelle alors un vrai certificat Let's Encrypt par domaine,
#     à la demande, dès que l'API confirme la vérification (TXT) via
#     `/api/internal/tls-authorize`.

{
	email admin@VOTREDOMAINE.TLD
	on_demand_tls {
		ask http://127.0.0.1:3333/api/internal/tls-authorize
		interval 2m
		burst 5
	}
}

# --- Hôtes Cloudflare (certificat d'origine statique, pas d'ACME public) ----
(cloudflare_origin) {
	tls /etc/caddy/certs/cloudflare-origin.pem /etc/caddy/certs/cloudflare-origin.key
}

# --- API -----------------------------------------------------------------
api.VOTREDOMAINE.TLD {
	import cloudflare_origin
	encode zstd gzip
	reverse_proxy 127.0.0.1:3333
}

# --- Back-office vendeur ---------------------------------------------------
dashboard.VOTREDOMAINE.TLD {
	import cloudflare_origin
	encode zstd gzip
	reverse_proxy 127.0.0.1:3001
}

# --- Console plateforme (opérateur) ----------------------------------------
console.VOTREDOMAINE.TLD {
	import cloudflare_origin
	encode zstd gzip
	reverse_proxy 127.0.0.1:3002
}

# --- Médias (lecture publique du bucket MinIO) -----------------------------
media.VOTREDOMAINE.TLD {
	import cloudflare_origin
	encode zstd gzip
	reverse_proxy 127.0.0.1:9000
}

# --- imgproxy (redimensionnement/optimisation des images) ------------------
img.VOTREDOMAINE.TLD {
	import cloudflare_origin
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080
}

# --- Vitrines : apex + sous-domaines de boutiques --------------------------
VOTREDOMAINE.TLD, www.VOTREDOMAINE.TLD, *.VOTREDOMAINE.TLD {
	import cloudflare_origin
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}

# --- Domaines personnalisés des boutiques (on-demand TLS, DNS direct) ------
:443 {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}
