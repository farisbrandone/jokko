# Caddy — production Jokko.
# TLS automatique. Domaines personnalisés de boutiques : on-demand TLS, autorisé
# par l'API. *.jokko.shop est servi derrière Cloudflare (proxied).

{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://api:3333/api/internal/tls-authorize
		interval 2m
		burst 5
	}
}

# --- API ---------------------------------------------------------------------
api.jokko.shop {
	encode zstd gzip
	reverse_proxy api:3333
}

# --- Back-office vendeur ----------------------------------------------------
dashboard.jokko.shop {
	encode zstd gzip
	reverse_proxy dashboard:3000
}

# --- Vitrines : sous-domaines de boutiques + apex -------------------------
jokko.shop, www.jokko.shop, *.jokko.shop {
	encode zstd gzip
	reverse_proxy storefront:3000
}

# --- Domaines personnalisés des boutiques (on-demand TLS) -----------------
:443 {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy storefront:3000
}
