# Jokko — variables de production pour un déploiement natif (nginx + pm2).
# Copier vers <racine du repo>/.env sur le VPS (jamais commité).
# Générer un secret : openssl rand -base64 36
#
# Différences avec infra/docker/.env.prod.example (Docker/Caddy conteneurisé) :
#  - les services de données (compose.data.yaml) sont joints en `localhost`,
#    pas par nom de conteneur (postgres/meilisearch/minio/imgproxy) ;
#  - pas de REGISTRY/IMAGE_TAG/ACME_EMAIL (pas d'images Docker pour les apps,
#    pas de Caddy — le certificat wildcard nginx est réglé directement dans
#    infra/nginx/jokko.conf, pas ici) ;
#  - REDIS_URL est omise : la variable existe dans le schéma mais n'est
#    utilisée par aucun module de l'application.
#
# Domaine déjà renseigné : scoliaa.com. Prêt à copier tel quel.

# ── TLS / domaines ───────────────────────────────────────────
SHOP_ROOT_DOMAIN=scoliaa.com
STOREFRONT_PUBLIC_URL=https://scoliaa.com
DASHBOARD_PUBLIC_URL=https://dashboard.scoliaa.com

# ── API ──────────────────────────────────────────────────────
API_PORT=3333
API_HOST=127.0.0.1
API_GLOBAL_PREFIX=api
API_CORS_ORIGINS=https://dashboard.scoliaa.com,https://console.scoliaa.com
LOG_LEVEL=info

# ── PostgreSQL (compose.data.yaml, lié sur 127.0.0.1:5432) ───
# ATTENTION : chaque mot de passe apparaît à DEUX endroits ci-dessous (une
# fois seul, une fois recopié dans une URL) — remplacez CHANGE_ME_pg_owner et
# CHANGE_ME_pg_app PARTOUT où ils apparaissent, avec exactement la même
# valeur les deux fois, sinon l'API échoue à se connecter (erreur
# "password authentication failed"). Générez-les avec `openssl rand -hex 32`
# (pas `-base64` : un `/` généré casserait l'URL postgres:// avec une
# erreur "Invalid URL").
POSTGRES_DB=jokko
POSTGRES_USER=jokko
POSTGRES_PASSWORD=CHANGE_ME_pg_owner
# Doit être identique au mot de passe dans DATABASE_ADMIN_URL ci-dessous.
JOKKO_APP_PASSWORD=CHANGE_ME_pg_app
# Doit être identique au mot de passe dans DATABASE_URL ci-dessous.
DATABASE_URL=postgres://jokko_app:CHANGE_ME_pg_app@localhost:5432/jokko
DATABASE_ADMIN_URL=postgres://jokko:CHANGE_ME_pg_owner@localhost:5432/jokko

# ── Meilisearch (compose.data.yaml, 127.0.0.1:7700) ──────────
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=CHANGE_ME_meili

# ── Object storage MinIO (compose.data.yaml, 127.0.0.1:9000) ─
# S3_ENDPOINT sert UNIQUEMENT à signer les URLs d'upload (aucun appel réseau
# direct de l'API vers ce endpoint) : ces URLs signées sont utilisées par le
# NAVIGATEUR (upload direct depuis le dashboard), donc l'hôte doit être
# PUBLIC et joignable par le client — pas localhost, même si l'API tourne
# sur le même hôte que MinIO. nginx (vhost media.*) relaie ensuite vers
# MinIO en 127.0.0.1:9000.
S3_ENDPOINT=https://media.scoliaa.com
S3_REGION=us-east-1
S3_ACCESS_KEY=jokko
S3_SECRET_KEY=CHANGE_ME_minio
S3_BUCKET=jokko-media
# URL publique de lecture des médias (vhost nginx media.*, voir jokko.conf)
S3_PUBLIC_URL=https://media.scoliaa.com/jokko-media

# ── imgproxy (compose.data.yaml, 127.0.0.1:8080) ─────────────
IMGPROXY_URL=https://img.scoliaa.com
# Laisser vide = imgproxy tourne sans signature de clé (URLs non signées).
# Pour signer (recommandé) : générer 2 hex 64 caractères et les fournir aussi
# comme variables d'env IMGPROXY_KEY / IMGPROXY_SALT au conteneur imgproxy.
IMGPROXY_KEY=
IMGPROXY_SALT=

# ── Auth ─────────────────────────────────────────────────────
AUTH_JWT_SECRET=CHANGE_ME_jwt
AUTH_ACCESS_TTL_MIN=30
AUTH_REFRESH_TTL_DAYS=30
AUTH_COOKIE_DOMAIN=.scoliaa.com

# ── Connexion sociale (OAuth) — laisser vide pour désactiver ──
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=https://api.scoliaa.com/api
OAUTH_POST_LOGIN_URL=https://dashboard.scoliaa.com
OAUTH_ALLOW_FAKE=false

# ── Passkeys (WebAuthn) ──
WEBAUTHN_RP_ID=scoliaa.com
WEBAUTHN_RP_NAME=Jokko
WEBAUTHN_ORIGINS=https://dashboard.scoliaa.com

# ── Multi-tenant ─────────────────────────────────────────────
TENANT_HEADER_SECRET=CHANGE_ME_tenant_hmac
# Vérification de domaine personnalisé : laisser VIDE en production.
DNS_STUB_ENABLED=

# ── Notifications (e-mail) — relais SMTP réel requis ─────────
SMTP_URL=smtp://apikey:CHANGE_ME@smtp.exemple.tld:587
SMTP_FROM=Jokko <no-reply@scoliaa.com>
DASHBOARD_BASE_URL=https://dashboard.scoliaa.com

# ── Notifications WhatsApp / SMS (Termii) — optionnel ────────
# Laisser TERMII_API_KEY vide pour désactiver (adaptateur « log »).
TERMII_API_KEY=
TERMII_SENDER_ID=Jokko
TERMII_BASE_URL=https://api.ng.termii.com
NOTIFICATIONS_COOLDOWN_SEC=300

# ── WhatsApp Cloud API (Meta) — 100 % optionnel ─────────────
# Nécessite un compte Meta Business VÉRIFIÉ + une app WhatsApp.
# Tant que TOKEN ou PHONE_NUMBER_ID est vide : priorité à Termii, sinon
# adaptateur « log ». L'application tourne normalement sans rien de tout ça.
# Tarif Meta : les conversations de service (réponse < 24 h à un message
# client) sont gratuites ; les notifications proactives par modèle sont
# facturées à la conversation (~0,005–0,08 USD selon le pays).
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v21.0
# Webhook entrant (GET https://api.scoliaa.com/api/whatsapp/webhook).
# VERIFY_TOKEN : chaîne au choix, recopiée dans la console Meta.
# APP_SECRET : « App secret » Meta — active la vérification X-Hub-Signature-256.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Connexion par SMS (OTP) — OTP_DEV_CODE doit rester vide en production
OTP_TTL_SEC=300
OTP_MAX_PER_HOUR=5
MESSAGING_MAX_NEW_CONVERSATIONS_PER_HOUR=6

# ── RGPD / rétention (cron quotidien `data-retention`) ──
RETENTION_ENABLED=true
RETENTION_ANALYTICS_DAYS=400
RETENTION_CONVERSATION_DAYS=365
RETENTION_DISPATCH_LOG_DAYS=90
RETENTION_IMPERSONATION_DAYS=365
RETENTION_ORDER_DAYS=365

# ── Notifications Web Push (VAPID) — `npx web-push generate-vapid-keys` ──
# Laisser vide pour désactiver (adaptateur « log »).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@scoliaa.com

# ── Facturation (abonnement vendeur — Flutterwave) — optionnel ──
# Laisser vide = passerelle « fake » (valide tout paiement automatiquement,
# À NE PAS GARDER pour de vrais paiements).
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=
FLW_BASE_URL=https://api.flutterwave.com
BILLING_PRICE_XOF=5000
BILLING_TRIAL_DAYS=14
BILLING_GRACE_DAYS=3
APP_PUBLIC_URL=https://dashboard.scoliaa.com

# ── Durcissement ──────────────────────────────────────────
THROTTLE_TTL_SEC=60
THROTTLE_LIMIT=600
# nginx tourne sur le même hôte : l'IP réelle du client arrive via
# X-Forwarded-For (voir snippets/jokko-proxy.conf), inutile de renseigner
# THROTTLE_TRUSTED_IPS ici.
THROTTLE_TRUSTED_IPS=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=jokko-api
# Métriques Prometheus (optionnel, voir docs/deploiement-vps.md §observabilité)
METRICS_ENABLED=true
METRICS_TOKEN=CHANGE_ME_metrics_bearer

# ── Sauvegardes (script infra/scripts/pg-backup.sh, cron) ───
BACKUP_BUCKET=jokko-backups
BACKUP_RETENTION_DAYS=14
