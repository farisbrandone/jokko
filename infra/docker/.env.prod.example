# Jokko — variables de production (copier vers infra/docker/.env, ne pas committer).
# Générer les secrets : openssl rand -base64 36

# ── Images ───────────────────────────────────────────────────
REGISTRY=ghcr.io/farisbrandone
IMAGE_TAG=latest

# ── TLS / domaines ───────────────────────────────────────────
ACME_EMAIL=admin@jokko.shop
SHOP_ROOT_DOMAIN=jokko.shop
STOREFRONT_PUBLIC_URL=https://jokko.shop
DASHBOARD_PUBLIC_URL=https://dashboard.jokko.shop

# ── API ──────────────────────────────────────────────────────
API_PORT=3333
API_HOST=0.0.0.0
API_GLOBAL_PREFIX=api
API_CORS_ORIGINS=https://dashboard.jokko.shop
LOG_LEVEL=info

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=jokko
POSTGRES_USER=jokko
POSTGRES_PASSWORD=CHANGE_ME_pg_owner
# Doit être identique au mot de passe dans DATABASE_URL ci-dessous.
JOKKO_APP_PASSWORD=CHANGE_ME_pg_app
DATABASE_URL=postgres://jokko_app:CHANGE_ME_pg_app@postgres:5432/jokko
DATABASE_ADMIN_URL=postgres://jokko:CHANGE_ME_pg_owner@postgres:5432/jokko

# ── Redis / Meilisearch ──────────────────────────────────────
REDIS_URL=redis://redis:6379
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=CHANGE_ME_meili

# ── Object storage (MinIO) ───────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=jokko
S3_SECRET_KEY=CHANGE_ME_minio
S3_BUCKET=jokko-media
# URL publique de lecture des médias (via Caddy ou CDN)
S3_PUBLIC_URL=https://media.jokko.shop/jokko-media

# ── imgproxy ─────────────────────────────────────────────────
IMGPROXY_URL=https://img.jokko.shop
IMGPROXY_KEY=CHANGE_ME_hex
IMGPROXY_SALT=CHANGE_ME_hex

# ── Auth ─────────────────────────────────────────────────────
AUTH_JWT_SECRET=CHANGE_ME_jwt
AUTH_ACCESS_TTL_MIN=30
AUTH_REFRESH_TTL_DAYS=30
AUTH_COOKIE_DOMAIN=.jokko.shop

# ── Connexion sociale (OAuth) — laisser vide pour désactiver ──
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=https://api.jokko.shop/api
OAUTH_POST_LOGIN_URL=https://dashboard.jokko.shop
OAUTH_ALLOW_FAKE=false
# Injecté au conteneur `dashboard` : URL publique de l'API (navigateur)
PUBLIC_API_BASE_URL=https://api.jokko.shop/api

# ── Passkeys (WebAuthn) ──
WEBAUTHN_RP_ID=jokko.shop
WEBAUTHN_RP_NAME=Jokko
WEBAUTHN_ORIGINS=https://dashboard.jokko.shop

# ── Multi-tenant ─────────────────────────────────────────────
TENANT_HEADER_SECRET=CHANGE_ME_tenant_hmac
# Vérification de domaine personnalisé : laisser VIDE en production
# (DNS_STUB_ENABLED=1 = résolveur TXT simulé, réservé aux tests / CI).
DNS_STUB_ENABLED=

# ── Notifications (e-mail) ───────────────────────────────────
SMTP_URL=smtp://apikey:CHANGE_ME@smtp.eu.postmarkapp.com:587
SMTP_FROM=Jokko <no-reply@jokko.shop>
DASHBOARD_BASE_URL=https://dashboard.jokko.shop

# ── Notifications WhatsApp / SMS (Termii) ────────────────────
TERMII_API_KEY=CHANGE_ME_termii_api_key
TERMII_SENDER_ID=Jokko
TERMII_BASE_URL=https://api.ng.termii.com
NOTIFICATIONS_COOLDOWN_SEC=300
# Connexion par SMS (OTP) — OTP_DEV_CODE doit rester vide
OTP_TTL_SEC=300
OTP_MAX_PER_HOUR=5
MESSAGING_MAX_NEW_CONVERSATIONS_PER_HOUR=6

# ── RGPD / rétention (cron quotidien `data-retention`) ──
RETENTION_ENABLED=true
RETENTION_ANALYTICS_DAYS=400
RETENTION_CONVERSATION_DAYS=365
RETENTION_DISPATCH_LOG_DAYS=90
RETENTION_IMPERSONATION_DAYS=365

# ── Notifications Web Push (VAPID) — `npx web-push generate-vapid-keys` ──
VAPID_PUBLIC_KEY=CHANGE_ME_vapid_public
VAPID_PRIVATE_KEY=CHANGE_ME_vapid_private
VAPID_SUBJECT=mailto:support@jokko.shop

# ── Facturation (abonnement vendeur — Flutterwave) ─────────
FLW_SECRET_KEY=CHANGE_ME_flw_secret
FLW_WEBHOOK_SECRET=CHANGE_ME_flw_webhook_hash
FLW_BASE_URL=https://api.flutterwave.com
BILLING_PRICE_XOF=5000
BILLING_TRIAL_DAYS=14
BILLING_GRACE_DAYS=3
APP_PUBLIC_URL=https://dashboard.jokko.shop

# ── Durcissement ──────────────────────────────────────────
THROTTLE_TTL_SEC=60
THROTTLE_LIMIT=600
# IP des conteneurs front (SSR interne) — à ajuster après `docker network inspect`
THROTTLE_TRUSTED_IPS=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=jokko-api
# Métriques Prometheus. Laisser METRICS_TOKEN vide = /metrics ouvert sur le
# réseau interne uniquement ; sinon renseigner le même jeton côté Prometheus.
METRICS_ENABLED=true
METRICS_TOKEN=CHANGE_ME_metrics_bearer
# Grafana (pile compose.obs.yaml)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin
GRAFANA_ROOT_URL=http://localhost:3009
# Sauvegardes (service `pg-backup`, profil tools)
BACKUP_BUCKET=jokko-backups
BACKUP_RETENTION_DAYS=14
